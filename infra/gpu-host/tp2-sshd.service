[Unit]
Description=SSH privado de TP2 sobre loopback WSL
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config_tp2
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config_tp2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
